# Copy to .env.local for the app. Never commit real values.
# Only public values belong here: anything prefixed EXPO_PUBLIC_ ends up in the app bundle.
# For local development, `npx supabase status -o env` prints the local API_URL and PUBLISHABLE_KEY.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# Server-only values. Set them with `supabase secrets set` (and in supabase/functions/.env for local serve).
# They must never be read by the app.
# GEMINI_API_KEY=
# GEMINI_MODEL_FEEDBACK=
# GEMINI_MODEL_LITE=
# GEMINI_MODEL_STT=
# GEMINI_MODEL_TTS=
