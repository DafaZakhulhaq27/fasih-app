{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"],
      "@core/*": ["./supabase/functions/_shared/core/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "supabase/functions/_shared/core/**/*.ts",
    "*.config.mts",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
